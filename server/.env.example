# Copy to .env for docker compose overrides
DATABASE_URL=postgres://rdh:rdh@127.0.0.1:5432/rdh
PORT=8080
SESSION_SECRET=generate-a-long-random-string
ADMIN_EMAIL=you@university.edu
ADMIN_PASSWORD=minimum-eight-chars
ALLOW_PUBLIC_REGISTER=0
SERVE_SPA=1
SPA_ROOT=../dist
COOKIE_SECURE=0
# NHDOT production: do not set ALLOW_CLOUD_NIM=1
